<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Your site address is typed in the app. https is strongly recommended; plain http is
         still allowed so a site without an SSL certificate keeps working. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
